<%# locals: (chat:) %>

<div id="<%= chat.error_target %>">
  <%= render DS::Alert.new(variant: :error, live: :alert) do %>
    <div class="flex items-center justify-between gap-2">
      <p><%= chat.presentable_error_message %></p>

      <%= render DS::Button.new(
        text: t(".retry"),
        href: retry_chat_path(chat),
      ) %>
    </div>
  <% end %>
</div>
